{
  "name": "sofistik-tools",
  "author": "lumine-code",
  "description": "Commands and integrations for SOFiSTiK structural analysis workflows.",
  "repository": "https://github.com/lumine-code/sofistik-tools",
  "bugs": {
    "url": "https://github.com/lumine-code/sofistik-tools/issues"
  },
  "keywords": [
    "structural-analysis",
    "fem",
    "cadinp",
    "civil-engineering",
    "wps"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can run a SOFiSTiK calculation on the current file with {{ 'sofistik-tools:calculation-wps' | keystroke }}"
  ],
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    },
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    },
    "sofistik.keywords": {
      "versions": {
        "^1.0.0": "consumeSofistikKeywords"
      }
    },
    "sofistik.environment": {
      "versions": {
        "^1.0.0": "consumeSofistikEnvironment"
      }
    },
    "pdf-view": {
      "versions": {
        "^1.0.0": "consumePdfView"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
