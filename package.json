{
  "name": "sofistik-tools",
  "author": "lumine-code",
  "description": "Commands and integrations for SOFiSTiK structural analysis workflows.",
  "repository": "https://github.com/lumine-code/sofistik-tools",
  "bugs": {
    "url": "https://github.com/lumine-code/sofistik-tools/issues"
  },
  "keywords": [
    "structural-analysis",
    "fem",
    "cadinp",
    "civil-engineering",
    "wps"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "language-sofistik",
    "language-text",
    "code-lens",
    "open-external"
  ],
  "main": "./lib/main",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "inlineActions": {
      "title": "Inline Run Actions",
      "description": "Show a Run link above each active +PROG header. Requires the code-lens package. Can also be changed in scoped language settings.",
      "type": "boolean",
      "scopeResolution": "grammar",
      "default": true
    }
  },
  "providedServices": {
    "code-lens.provider": {
      "versions": {
        "1.0.0": "provideCodeLens"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    },
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    },
    "pdf-view": {
      "versions": {
        "^1.0.0": "consumePdfView"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "@lumine-code/sofistik-schema": "github:lumine-code/sofistik-schema#851e5882e5f2dec8538edc1e5c649fff33b523cc",
    "@lumine-code/sofistik-context": "github:lumine-code/sofistik-context#b3c11f0be26f32810a284b86bd066feddea3d207"
  }
}
