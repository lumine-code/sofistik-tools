{
  "name": "sofistik-tools",
  "author": "lumine-code",
  "description": "Commands and integrations for SOFiSTiK structural analysis workflows.",
  "repository": "https://github.com/lumine-code/sofistik-tools",
  "bugs": {
    "url": "https://github.com/lumine-code/sofistik-tools/issues"
  },
  "keywords": [
    "structural-analysis",
    "fem",
    "cadinp",
    "civil-engineering",
    "wps"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "language-sofistik",
    "language-text"
  ],
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    },
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    },
    "pdf-view": {
      "versions": {
        "^1.0.0": "consumePdfView"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "@lumine-code/sofistik-data": "github:lumine-code/sofistik-data#03f166d91b41a3f045242dc190bf78c587203243"
  }
}
