{
  // :not([mini]) so these never reach a find field or a commit box, matching
  // tasklist-tools. The handlers act on the file the grammar belongs to.
  "lumine-text-editor[data-grammar=\"source sofistik\"]:not([mini])": {
    "f5": "sofistik-tools:calculation-wps",
    "ctrl-f5": "sofistik-tools:calculation-wps-immediately",
    "shift-f5": "sofistik-tools:calculation-wps-current",
    "alt-f5": "sofistik-tools:calculation-sps",
    "f7": "sofistik-tools:open-animator",
    "f8": "sofistik-tools:open-wingraf",
    "ctrl-f8": "sofistik-tools:open-result-viewer",
    "f9": "sofistik-tools:open-report"
  },
  "lumine-text-editor[data-grammar~=\"sofistik\"]:not([mini])": {
    "f6": "sofistik-tools:current-help",
    "alt-f6": "sofistik-tools:separately-help"
  },
  ".sofistik-tools.help-list lumine-text-editor[mini]": {
    "f5": "sofistik-tools:cache-help",
    "alt-enter": "sofistik-tools:open-help-with",
    "ctrl-alt-enter": "sofistik-tools:open-ex",
    "alt-shift-enter": "sofistik-tools:show-help-in-folder"
  },
  ".sofistik-tools.example-list lumine-text-editor[mini]": {
    "alt-enter": "sofistik-tools:open-example-with",
    "ctrl-alt-enter": "sofistik-tools:open-example-external",
    "alt-shift-enter": "sofistik-tools:show-example-in-folder",
    "f5": "sofistik-tools:cache-examples"
  }
}
